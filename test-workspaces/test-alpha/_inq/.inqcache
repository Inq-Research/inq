{"sha256":"sha256:3531c65b59ef280b53da5ae6fe8dae9ecfcd8e125390d4387a82e39801a874d7","data":"{\"version\":2,\"resources\":{\"inq.toml\":{\"sha256\":\"sha256:67328c223463c0ee66690021665a254d3a85e2f38cce77614e8e80aa1ba09e32\",\"markdown\":null,\"marker\":null},\"modules/alpha-intro/data/measurements.csv\":{\"sha256\":\"sha256:8b88ce52510ae3d563c5fb9123c090899621ee24f43ec49ee3ecaf939c38a863\",\"markdown\":null,\"marker\":null},\"modules/alpha-intro/diagram.svg\":{\"sha256\":\"sha256:09172fa7ce4d001e89b1ad45f5d6713609cc391cad802910db88518a0a80d629\",\"markdown\":null,\"marker\":null},\"modules/alpha-intro/inq.md\":{\"sha256\":\"sha256:376defb093d61dc5f17004911e62cea9622192ed682da62b8d337bb935ebd169\",\"markdown\":{\"analysis\":{\"title\":\"Alpha introduction\",\"summary\":\"The entry point for a small linked collection that can be imported under any workspace alias while retaining its canonical module name.\",\"text_before_h1\":false},\"links\":[\"notes/welcome.md\",\"diagram.svg\"],\"occurrences\":[{\"range\":{\"start\":302,\"end\":334},\"destination_range\":{\"start\":317,\"end\":333},\"syntax\":\"MarkdownInline\",\"presentation\":\"Link\",\"target\":{\"resource\":\"notes/welcome.md\",\"query\":null,\"fragment\":null},\"label\":\"welcome note\",\"title\":null},{\"range\":{\"start\":378,\"end\":400},\"destination_range\":{\"start\":388,\"end\":399},\"syntax\":\"MarkdownInline\",\"presentation\":\"Link\",\"target\":{\"resource\":\"diagram.svg\",\"query\":null,\"fragment\":null},\"label\":\"diagram\",\"title\":null}]},\"marker\":{\"name\":\"alpha-intro\",\"include\":[\"./notes/*.md\"],\"exclude\":[],\"ambient\":[\"./data/*.csv\"],\"labels\":{\"purpose\":[\"test-fixture\"]}}},\"modules/alpha-intro/notes/welcome.md\":{\"sha256\":\"sha256:a99f4c8d9c8eeb7e5cb0d8fc296fe18fd5be6adb987658fdc032f45b12356f8e\",\"markdown\":{\"analysis\":{\"title\":\"Welcome to Alpha\",\"summary\":\"This selected note introduces a dependency from a nested resource path. Follow the reference for the next step in the chain.\",\"text_before_h1\":false},\"links\":[\"../../alpha-reference/inq.md\"],\"occurrences\":[{\"range\":{\"start\":103,\"end\":144},\"destination_range\":{\"start\":115,\"end\":143},\"syntax\":\"MarkdownInline\",\"presentation\":\"Link\",\"target\":{\"resource\":\"../../alpha-reference/inq.md\",\"query\":null,\"fragment\":null},\"label\":\"reference\",\"title\":null}]},\"marker\":null},\"modules/alpha-leaf/inq.md\":{\"sha256\":\"sha256:14a0519de746bb618e57b20e878b5a906f04dff743298fa2d1e9cd87f44fbc87\",\"markdown\":{\"analysis\":{\"title\":\"Alpha leaf\",\"summary\":\"The end of the Alpha collection’s dependency chain. This module has no outbound links and provides a small, deterministic leaf for closure tests.\",\"text_before_h1\":false},\"links\":[],\"occurrences\":[]},\"marker\":{\"name\":\"alpha-leaf\",\"include\":[],\"exclude\":[],\"ambient\":[],\"labels\":{\"purpose\":[\"test-fixture\"]}}},\"modules/alpha-reference/inq.md\":{\"sha256\":\"sha256:9d29537881d2ee8eac7b298e5c650e7787707d82f78865321d8beeead3dde1df\",\"markdown\":{\"analysis\":{\"title\":\"Alpha reference\",\"summary\":\"The intermediate module in the Alpha collection. Its link to the leaf makes that module a transitive dependency of the introduction, at the same publishing commit and workspace path.\",\"text_before_h1\":false},\"links\":[\"../alpha-leaf/inq.md\"],\"occurrences\":[{\"range\":{\"start\":158,\"end\":186},\"destination_range\":{\"start\":165,\"end\":185},\"syntax\":\"MarkdownInline\",\"presentation\":\"Link\",\"target\":{\"resource\":\"../alpha-leaf/inq.md\",\"query\":null,\"fragment\":null},\"label\":\"leaf\",\"title\":null}]},\"marker\":{\"name\":\"alpha-reference\",\"include\":[],\"exclude\":[],\"ambient\":[],\"labels\":{\"purpose\":[\"test-fixture\"]}}},\"modules/alpha-unlinked/inq.md\":{\"sha256\":\"sha256:14115a17b10e18c8896107e50005eb3d8a28e3514b2497db7897d63eb411cb25\",\"markdown\":{\"analysis\":{\"title\":\"Alpha unlinked module\",\"summary\":\"An independent module in the same publishing workspace. Importing the Alpha introduction must leave this module out because no module in that closure links to it.\",\"text_before_h1\":false},\"links\":[],\"occurrences\":[]},\"marker\":{\"name\":\"alpha-unlinked\",\"include\":[],\"exclude\":[],\"ambient\":[],\"labels\":{\"purpose\":[\"test-fixture\"]}}},\"overview.md\":{\"sha256\":\"sha256:6a505fd2796b773b873a553541bff6f8ac0a147084cfa49dd863c9a6e05daa10\",\"markdown\":{\"analysis\":{\"title\":\"Test Alpha\",\"summary\":\"A small publishing workspace for live GitHub acquisition tests, rooted below the repository’s own workspace. Start with the introduction.\",\"text_before_h1\":false},\"links\":[\"modules/alpha-intro/inq.md\",\"modules/alpha-reference/inq.md\",\"modules/alpha-leaf/inq.md\",\"modules/alpha-unlinked/inq.md\"],\"occurrences\":[{\"range\":{\"start\":138,\"end\":180},\"destination_range\":{\"start\":153,\"end\":179},\"syntax\":\"MarkdownInline\",\"presentation\":\"Link\",\"target\":{\"resource\":\"modules/alpha-intro/inq.md\",\"query\":null,\"fragment\":null},\"label\":\"introduction\",\"title\":null},{\"range\":{\"start\":213,\"end\":256},\"destination_range\":{\"start\":225,\"end\":255},\"syntax\":\"MarkdownInline\",\"presentation\":\"Link\",\"target\":{\"resource\":\"modules/alpha-reference/inq.md\",\"query\":null,\"fragment\":null},\"label\":\"reference\",\"title\":null},{\"range\":{\"start\":277,\"end\":310},\"destination_range\":{\"start\":284,\"end\":309},\"syntax\":\"MarkdownInline\",\"presentation\":\"Link\",\"target\":{\"resource\":\"modules/alpha-leaf/inq.md\",\"query\":null,\"fragment\":null},\"label\":\"leaf\",\"title\":null},{\"range\":{\"start\":316,\"end\":364},\"destination_range\":{\"start\":334,\"end\":363},\"syntax\":\"MarkdownInline\",\"presentation\":\"Link\",\"target\":{\"resource\":\"modules/alpha-unlinked/inq.md\",\"query\":null,\"fragment\":null},\"label\":\"unlinked module\",\"title\":null}]},\"marker\":null}}}"}